import { z } from 'zod/v3';
import type OpenAI from 'openai';

export function register{{pascalCase name}}(server: import('@modelcontextprotocol/sdk/server/mcp.js').McpServer, openai: OpenAI) {
  server.tool(
    '{{name}}',
    '{{description}}',
    {
      {{#each parameters.properties}}
      {{@key}}: z.{{zodType this}}(){{#if this.description}}.describe('{{this.description}}'){{/if}},
      {{/each}}
    },
    async ({ {{parameterList}} }) => {
      // TODO: Implement {{name}} AI tool operation
      try {
        const completion = await openai.chat.completions.create({
          model: 'gpt-4o-mini',
          messages: [{ role: 'user', content: prompt }],
        });
        return {
          content: [{ type: 'text', text: completion.choices[0]?.message?.content || 'No response' }],
        };
      } catch (error) {
        return {
          content: [{ type: 'text', text: `Error: ${error instanceof Error ? error.message : String(error)}` }],
          isError: true,
        };
      }
    }
  );
}
