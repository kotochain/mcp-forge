import { z } from 'zod/v3';
import type Database from 'better-sqlite3';

export function register{{pascalCase name}}(server: import('@modelcontextprotocol/sdk/server/mcp.js').McpServer, db: Database.Database) {
  server.tool(
    '{{name}}',
    '{{description}}',
    {
      {{#each parameters.properties}}
      {{@key}}: z.{{zodType this}}(){{#if this.description}}.describe('{{this.description}}'){{/if}},
      {{/each}}
    },
    async ({ {{parameterList}} }) => {
      // TODO: Implement {{name}} database operation
      try {
        const result = db.prepare('SELECT 1 as test').all();
        return {
          content: [{ type: 'text', text: JSON.stringify(result, null, 2) }],
        };
      } catch (error) {
        return {
          content: [{ type: 'text', text: `Error: ${error instanceof Error ? error.message : String(error)}` }],
          isError: true,
        };
      }
    }
  );
}
